# Copy this file to ".env" and fill in your own values.
# Secrets are read by the MAIN process only (never exposed to the renderer/UI).

# Sarvam AI - real-time speech-to-text (PRIMARY; auto-falls back to Deepgram)
SARVAM_API_KEY=

# Deepgram - real-time speech-to-text (fallback)
DEEPGRAM_API_KEY=
# Set to "true" only if you are behind a corporate TLS-inspecting proxy and the
# speech WebSocket fails its certificate check (dev machines only).
DEEPGRAM_ALLOW_INSECURE_TLS=false

# Azure OpenAI - LLM suggestions
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=rudhra-gpt-5.4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
