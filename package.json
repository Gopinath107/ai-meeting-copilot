{
  "name": "ai-meeting-copilot",
  "version": "0.1.0",
  "description": "Desktop interview and meeting copilot with live transcription and AI guidance",
  "author": "Gopinath Kannan",
  "main": "./out/main/index.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Gopinath107/ai-meeting-copilot.git"
  },
  "homepage": "https://github.com/Gopinath107/ai-meeting-copilot",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-deps.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/generate-build-metadata.mjs",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir --publish never",
    "build:win": "npm run build && electron-builder --win --x64 --publish never",
    "release:win": "electron-builder --win --x64 --publish never -c.forceCodeSigning=true",
    "release:checksums": "node scripts/generate-checksums.mjs dist",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "audit:security": "npm audit --audit-level=high",
    "preview": "electron-vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "6.8.9",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.7",
    "electron-vite": "5.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "7.3.6",
    "vitest": "^4.1.10"
  }
}
